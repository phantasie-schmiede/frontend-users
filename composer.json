{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\FrontendUsers\\": "Classes/"
        }
    },
    "config": {
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "description": "a versatile set of tools and objects for dealing with frontend-users",
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "frontend_users",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "configuration",
        "development",
        "extension",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psbits/frontend-users",
    "require": {
        "php": "^8.3",
        "psbits/foundation": "^3.0",
        "typo3/cms-core": "^13.4"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "type": "typo3-cms-extension"
}
