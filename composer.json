{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\FrontendUsers\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSBits\\FrontendUsers\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "description": "a versatile set of tools and objects for dealing with frontend-users",
    "extra": {
        "typo3/cms": {
            "extension-key": "frontend_users",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "configuration",
        "development",
        "extension",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psbits/frontend-users",
    "require": {
        "php": "^8.3",
        "psbits/foundation": "^4.2.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "psbits/qa": "0.x.*@dev",
        "roave/security-advisories": "dev-latest",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
        "typo3/testing-framework": "^9.5"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:phantasie-schmiede/qa.git"
        }
    ],
    "scripts": {
        "analyze:php": "phpstan analyse --configuration=Build/Quality/phpstan.neon.dist --no-progress",
        "audit:composer": "composer audit --abandoned=report",
        "fix:all": [
            "@fix:classes",
            "@fix:htmlxml",
            "@fix:php"
        ],
        "fix:classes": "npm run fix:classes",
        "fix:htmlxml": "npm run fix:htmlxml",
        "fix:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --verbose",
        "lint:all": [
            "@analyze:php",
            "@audit:composer",
            "@lint:classes",
            "@lint:htmlxml",
            "@lint:php",
            "@lint:yaml",
            "@validate:composer"
        ],
        "lint:classes": "npm run lint:classes",
        "lint:htmlxml": "npm run lint:htmlxml",
        "lint:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "lint:yaml": "yamllint -c .Build/vendor/psbits/qa/Resources/Quality/yamllint.yml Configuration",
        "post-install-cmd": [
            "npm install",
            ".Build/bin/qa link"
        ],
        "post-update-cmd": [
            ".Build/bin/qa link"
        ],
        "qa": [
            "@fix:all",
            "@lint:all",
            "@test:all"
        ],
        "test:all": [
            "@test:unit",
            "@test:functional",
            "@test:local",
            "@test:docker"
        ],
        "test:coverage": "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runCoverage.sh @additional_args",
        "test:coverage:update-baseline": "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runCoverage.sh --update-baseline @additional_args",
        "test:docker": [
            "Composer\\Config::disableProcessTimeout",
            "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runDockerTests.sh @additional_args"
        ],
        "test:functional": [
            "php .Build/vendor/psbits/qa/Resources/Testing/renderPhpunitXml.php functional",
            "php -d memory_limit=1G .Build/bin/phpunit -c .Build/phpunit/FunctionalTests.xml"
        ],
        "test:local": [
            "Composer\\Config::disableProcessTimeout",
            "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runLocalTests.sh @additional_args"
        ],
        "test:unit": [
            "php .Build/vendor/psbits/qa/Resources/Testing/renderPhpunitXml.php unit",
            "php -d memory_limit=1G .Build/bin/phpunit -c .Build/phpunit/UnitTests.xml"
        ],
        "validate:composer": "composer validate --no-check-publish"
    },
    "type": "typo3-cms-extension"
}
